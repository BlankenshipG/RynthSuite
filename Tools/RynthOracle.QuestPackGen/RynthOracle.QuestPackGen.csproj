<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Builds RynthOracle's Aelrynth quest pack (Plugins\RynthCore.Plugin.RynthOracle\Resources\
    quests.aelrynth.csv) from a world-database BACKUP DUMP (mysqldump .sql or .sql.gz), never
    from a live database: by default the newest C:\Aeshnidae\backups\aeshnidae_world-*.sql.gz.
    Re-run it after content changes, then rebuild the plugin.

    Run (from this folder):
      dotnet run -c Release
      dotnet run -c Release (two dashes) -dump file.sql.gz -resources pluginResourcesDir -out file.csv -server Aelrynth
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>RynthOracle.QuestPackGen</RootNamespace>
  </PropertyGroup>

</Project>
