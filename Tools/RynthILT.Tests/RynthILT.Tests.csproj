<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the RynthILT plugin: the ACECustom bounty tracker (Bounty/, ported from SilentKelpie's
    rynth/RynthSuite PR #11 with his BountyTests) and the ILT Hub moved out of RynthAi 2026-10-13
    (the attribute raiser and aug costs, bank commands and the sigil chain, which ran in
    RynthCore.RynthAiHostTests before, plus the move itself: data migration, the RynthILT.Hub
    interface table, which "/ra" verbs RynthILT takes, the host-backed object view).

    Like RynthCore.RynthAiHostTests this references the plugin project itself, so it is a
    net10.0-windows x86 exe and needs the x86 .NET runtime (C:\Program Files (x86)\dotnet). The
    plugin grants InternalsVisibleTo to this assembly name. The fake engine host is the RynthAi
    host tests' FakeHost (linked; RYNTHILT_TESTS leaves out its RynthAi-only helpers). File tests
    use a scratch folder next to the exe, never %APPDATA%\RynthCore or C:\Games.
    Run: dotnet run -c Release   (exit 0 = pass, 1 = fail; an argument filters by test name)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>RynthILT.Tests</RootNamespace>
    <AssemblyName>RynthILT.Tests</AssemblyName>
    <Platforms>x86</Platforms>
    <DefineConstants>$(DefineConstants);RYNTHILT_TESTS</DefineConstants>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Plugins\RynthCore.Plugin.RynthILT\RynthCore.Plugin.RynthILT.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ILT's /fship commands: RynthILT's list and the shared "servercommands" format (both in the
         plugin above) checked against RynthAi's store for them. -->
    <Compile Include="..\..\Plugins\RynthCore.Plugin.RynthAi\Huds\ServerCommandModel.cs" Link="RynthAi\ServerCommandModel.cs" />
    <!-- The RynthAi test tools' check/runner harness and fake engine host (no plugin code in them). -->
    <Compile Include="..\RynthCore.RynthAiTests\Harness\Check.cs" Link="Harness\Check.cs" />
    <Compile Include="..\RynthCore.RynthAiTests\Harness\Runner.cs" Link="Harness\Runner.cs" />
    <Compile Include="..\RynthCore.RynthAiHostTests\Fakes\FakeHost.cs" Link="Fakes\FakeHost.cs" />
  </ItemGroup>

  <!-- The engine's Bounties snapshot reader (self-contained DTOs), so BountyTests checks the plugin's
       JSON against the engine's own reader. Optional, so this builds before the engine side is
       merged: without the file the round-trip check is compiled out (ENGINE_BOUNTIES). -->
  <PropertyGroup Condition="Exists('..\..\..\RynthCore\src\RynthCore.Engine\UI\Data\BountiesSnapshotJson.cs')">
    <DefineConstants>$(DefineConstants);ENGINE_BOUNTIES</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="Exists('..\..\..\RynthCore\src\RynthCore.Engine\UI\Data\BountiesSnapshotJson.cs')">
    <Compile Include="..\..\..\RynthCore\src\RynthCore.Engine\UI\Data\BountiesSnapshotJson.cs" Link="Engine\BountiesSnapshotJson.cs" />
  </ItemGroup>

  <!-- The engine supplies cimgui; never copy ImGui.NET's own next to the test exe either. -->
  <Target Name="RemoveBundledImGuiNative" AfterTargets="Build">
    <Delete Files="$(OutputPath)cimgui.dll" Condition="Exists('$(OutputPath)cimgui.dll')" />
  </Target>

</Project>
