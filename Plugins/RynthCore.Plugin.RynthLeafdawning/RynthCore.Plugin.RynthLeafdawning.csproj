<Project Sdk="Microsoft.NET.Sdk">

  <!-- RynthLeafdawning: the Leafdawning server plugin (not LeafDawn, which has RynthLeafDawn). The build is shared
       (..\Shared\ServerPack\ServerPlugin.props); ServerData.cs holds what is known about the server. -->
  <PropertyGroup>
    <AssemblyName>RynthCore.Plugin.RynthLeafdawning</AssemblyName>
    <!-- First release (no previous). -->
    <Version>0.1.0</Version>
    <RynthPluginServerId>leafdawning</RynthPluginServerId>
    <RynthPluginServerName>Leafdawning</RynthPluginServerName>
    <RynthPluginServerHosts>leafdawning.duckdns.org</RynthPluginServerHosts>
    <RynthPluginServerWorldNames>Leafdawning</RynthPluginServerWorldNames>
    <RynthPluginDescription>Leafdawning only: the server card (rules, account limits, botting policy, links, account setup) in the Mini Remote.</RynthPluginDescription>
  </PropertyGroup>

  <Import Project="..\Shared\ServerPack\ServerPlugin.props" />

</Project>
