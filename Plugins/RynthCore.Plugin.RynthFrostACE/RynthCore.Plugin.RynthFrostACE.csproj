<Project Sdk="Microsoft.NET.Sdk">

  <!-- RynthFrostACE: the FrostACE server plugin (listed as "FrostfACE" in the public server list). The build
       is shared (..\Shared\ServerPack\ServerPlugin.props); ServerData.cs holds what is known about the server. -->
  <PropertyGroup>
    <AssemblyName>RynthCore.Plugin.RynthFrostACE</AssemblyName>
    <!-- First release (no previous). -->
    <Version>0.1.0</Version>
    <RynthPluginServerId>frostace</RynthPluginServerId>
    <RynthPluginServerName>FrostACE</RynthPluginServerName>
    <RynthPluginServerHosts>172.111.230.127</RynthPluginServerHosts>
    <RynthPluginServerWorldNames>FrostACE|FrostfACE</RynthPluginServerWorldNames>
    <RynthPluginDescription>FrostACE only: the server card (rules, account limits, botting policy, links, account setup) in the Mini Remote.</RynthPluginDescription>
  </PropertyGroup>

  <Import Project="..\Shared\ServerPack\ServerPlugin.props" />

</Project>
