<Project Sdk="Microsoft.NET.Sdk">

  <!-- RynthThistlecrown: the Thistlecrown server plugin. The build is shared (..\Shared\ServerPack\ServerPlugin.props);
       ServerData.cs holds what is known about the server. -->
  <PropertyGroup>
    <AssemblyName>RynthCore.Plugin.RynthThistlecrown</AssemblyName>
    <!-- First release (no previous). -->
    <Version>0.1.0</Version>
    <RynthPluginServerId>thistlecrown</RynthPluginServerId>
    <RynthPluginServerName>Thistlecrown</RynthPluginServerName>
    <RynthPluginServerHosts>thistlecrown.ddns.net</RynthPluginServerHosts>
    <RynthPluginServerWorldNames>Thistlecrown</RynthPluginServerWorldNames>
    <RynthPluginDescription>Thistlecrown only: the server card (rules, account limits, botting policy, links, account setup) in the Mini Remote.</RynthPluginDescription>
  </PropertyGroup>

  <Import Project="..\Shared\ServerPack\ServerPlugin.props" />

</Project>
