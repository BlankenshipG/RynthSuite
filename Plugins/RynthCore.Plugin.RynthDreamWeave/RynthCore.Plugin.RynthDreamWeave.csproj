<Project Sdk="Microsoft.NET.Sdk">

  <!-- RynthDreamWeave: the DreamWeave server plugin. The build is shared (..\Shared\ServerPack\ServerPlugin.props);
       ServerData.cs holds what is known about the server. -->
  <PropertyGroup>
    <AssemblyName>RynthCore.Plugin.RynthDreamWeave</AssemblyName>
    <!-- Previous release: 0.1.2. -->
    <Version>0.1.4</Version>
    <RynthPluginServerId>dreamweave</RynthPluginServerId>
    <RynthPluginServerName>DreamWeave</RynthPluginServerName>
    <RynthPluginServerHosts>play.acdreamweave.com</RynthPluginServerHosts>
    <RynthPluginServerWorldNames>DreamWeave|Dream Weave</RynthPluginServerWorldNames>
    <RynthPluginDescription>DreamWeave only: the server card (rules, account limits, botting policy, links, account setup) in the Mini Remote.</RynthPluginDescription>
  </PropertyGroup>

  <Import Project="..\Shared\ServerPack\ServerPlugin.props" />

</Project>
