<Project Sdk="Microsoft.NET.Sdk">

  <!-- RynthReefcull: the Reefcull server plugin (GDLE). The build is shared (..\Shared\ServerPack\ServerPlugin.props);
       ServerData.cs holds what is known about the server. -->
  <PropertyGroup>
    <AssemblyName>RynthCore.Plugin.RynthReefcull</AssemblyName>
    <!-- First release (no previous). -->
    <Version>0.1.1</Version>
    <RynthPluginServerId>reefcull</RynthPluginServerId>
    <RynthPluginServerName>Reefcull</RynthPluginServerName>
    <RynthPluginServerHosts>reefcull.gdleac.com</RynthPluginServerHosts>
    <RynthPluginServerWorldNames>Reefcull</RynthPluginServerWorldNames>
    <RynthPluginDescription>Reefcull only: the server card (rules, account limits, botting policy, links, account setup) in the Mini Remote.</RynthPluginDescription>
  </PropertyGroup>

  <Import Project="..\Shared\ServerPack\ServerPlugin.props" />

</Project>
