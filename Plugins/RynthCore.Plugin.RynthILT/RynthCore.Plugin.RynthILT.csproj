<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RynthILT: features for Infinite Leaftide (ILT), the ACECustom server. The engine shows its
    panels (the bar's ILT button, /rc bounties) only on ILT (RynthCore Compatibility/IltInfo.cs).
    First feature: the Bounties window's tracker (Bounty/, ported from SilentKelpie's
    rynth/RynthSuite PR #11). Second: a copy of the ILT settings (IltSettings/), drawn with ImGui
    in RynthCore's Mini Remote and its own window. ILT features live here, not in RynthAi or the
    engine core.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <StripSymbols>false</StripSymbols>
    <RootNamespace>RynthCore.Plugin.RynthILT</RootNamespace>
    <AssemblyName>RynthCore.Plugin.RynthILT</AssemblyName>
    <Platforms>x86</Platforms>
    <!-- Plugin manifest (embedded in the DLL; Plugins\Directory.Build.targets). minEngineApi is the
         highest API use NOT behind a Has*/version check. Nothing above the v66 baseline: chat
         commands, world and object names, and the plugin-command broker are behind
         HasInvokeChatParser / HasGetWorldName / HasGetObjectName / HasSendPluginCommand. -->
    <RynthPluginMinEngineApi>66</RynthPluginMinEngineApi>
    <RynthPluginDescription>Infinite Leaftide (ACECustom) features: the Bounties window, the ILT settings and the /fship fellowship commands.</RynthPluginDescription>
    <!-- RynthILT is ILT's server plugin: RynthCore loads it only for clients connecting to ILT (or when no
         installed server plugin claims the host). Same lists as RynthCore's IltDetect defaults. -->
    <RynthPluginServerId>ilt</RynthPluginServerId>
    <RynthPluginServerName>Infinite Leaftide</RynthPluginServerName>
    <RynthPluginServerHosts>infiniteleaftide.online</RynthPluginServerHosts>
    <RynthPluginServerWorldNames>InfiniteLeaftide|*Leaftide*</RynthPluginServerWorldNames>
  </PropertyGroup>

  <ItemGroup>
    <!-- ImGui text calls for non-literal text ('%' escaped): see the file's header. -->
    <Compile Include="..\Shared\SafeImGui.cs" Link="Shared\SafeImGui.cs" />
    <!-- ILT's /fship commands: sent to RynthAi's Fellowship tab, and drawn in RynthCore's Fellowship section. -->
    <Compile Include="..\Shared\ServerCommandShare.cs" Link="Shared\ServerCommandShare.cs" />
    <Compile Include="..\Shared\ServerCommandPanel.cs" Link="Shared\ServerCommandPanel.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    <TrimmerRootAssembly Include="ImGui.NET" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\RynthCore\src\RynthCore.PluginCore\RynthCore.PluginCore.csproj" />
    <ProjectReference Include="..\..\..\RynthCore\src\RynthCore.PluginSdk\RynthCore.PluginSdk.csproj" />
  </ItemGroup>

  <!-- The engine already loaded cimgui.dll into the client; a second copy next to the plugin is never used. -->
  <Target Name="RemoveBundledImGuiNativeFromBuild" AfterTargets="Build">
    <Delete Files="$(OutputPath)cimgui.dll" Condition="Exists('$(OutputPath)cimgui.dll')" />
  </Target>

  <Target Name="RemoveBundledImGuiNativeFromPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <Delete Files="$(PublishDir)cimgui.dll" Condition="Exists('$(PublishDir)cimgui.dll')" />
  </Target>

</Project>
