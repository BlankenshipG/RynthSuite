<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RynthILT: features for Infinite Leaftide (ILT), the ACECustom server. ILT features live here,
    not in RynthAi or the engine core. The engine shows its panels (the bar's ILT button: Bounties,
    Guardian; /rc bounties, /rc guardian; the Skills panel's Progression tab) only on ILT
    (RynthCore Compatibility/IltInfo.cs, which also asks RynthILT).
      Bounty/          the Bounties window's tracker (ported from SilentKelpie's rynth/RynthSuite PR #11).
      Hub/             the ILT Hub (SilentKelpie's): the Mini Remote's ILT tabs (Character, Banking, Gear,
                       Charms, Games), the Guardian, the progression planners and the attribute raiser,
                       server feature detection. Moved out of RynthAi 2026-10-13: RynthAi's Mini Remote
                       hosts the tabs through RynthILT.Hub, and RynthILT borrows from RynthAi through
                       RynthAi.Hub (Plugins/Shared/RynthIltHubApi.cs, RynthAiHubApi.cs).
      IltSettingsView/ a copy of the ILT settings (RynthCore's verdict, this character's override, the
                       ILT world names, the Hub's feature read), in RynthCore's Mini Remote and its
                       own window ("/ilt settings").
      IltFellowship/   ILT's /fship commands as buttons (RynthCore's Fellowship section, "/ilt fellow",
                       and RynthAi's Fellowship view).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <StripSymbols>false</StripSymbols>
    <RootNamespace>RynthCore.Plugin.RynthILT</RootNamespace>
    <AssemblyName>RynthCore.Plugin.RynthILT</AssemblyName>
    <Platforms>x86</Platforms>
    <!-- Plugin manifest (embedded in the DLL; Plugins\Directory.Build.targets). minEngineApi is the
         highest API use NOT behind a Has*/version check. Nothing above the v66 baseline: every
         newer call (plugin interfaces v68, live object ids v69, vendor trade v67, the chat parser,
         world names and the plugin-command broker) is behind its Has* check, as it was in RynthAi. -->
    <RynthPluginMinEngineApi>66</RynthPluginMinEngineApi>
    <RynthPluginDescription>Infinite Leaftide (ACECustom) features: the ILT Hub (the Mini Remote's ILT tabs: banking, gear, charms, games), the Guardian, bounties, progression, the attribute raiser, the ILT settings and the /fship fellowship commands.</RynthPluginDescription>
    <!-- RynthILT is ILT's server plugin: RynthCore loads it only for clients connecting to ILT (or when no
         installed server plugin claims the host). Same lists as RynthCore's IltDetect defaults. -->
    <RynthPluginServerId>ilt</RynthPluginServerId>
    <RynthPluginServerName>Infinite Leaftide</RynthPluginServerName>
    <RynthPluginServerHosts>infiniteleaftide.online</RynthPluginServerHosts>
    <RynthPluginServerWorldNames>InfiniteLeaftide|*Leaftide*</RynthPluginServerWorldNames>
  </PropertyGroup>

  <ItemGroup>
    <!-- RynthAi hosts the ILT tabs in its Mini Remote and lends its quest tracker, spell names and
         loot matching (RynthAi.Hub). Optional: without it the panels and commands still work. -->
    <RynthPluginDependency Include="RynthAi" Optional="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- The two interfaces between RynthILT and RynthAi (linked into both plugins). -->
    <Compile Include="..\Shared\RynthIltHubApi.cs" Link="Shared\RynthIltHubApi.cs" />
    <Compile Include="..\Shared\RynthIltServerApi.cs" Link="Shared\RynthIltServerApi.cs" />
    <Compile Include="..\Shared\RynthIltDataApi.cs" Link="Shared\RynthIltDataApi.cs" />
    <Compile Include="..\Shared\RynthAiHubApi.cs" Link="Shared\RynthAiHubApi.cs" />
    <!-- RynthCore's server list (API v86): the ILT verdict the Hub follows (IltSettingsView/). -->
    <Compile Include="..\Shared\EngineServerState.cs" Link="Shared\EngineServerState.cs" />
    <!-- "RynthServer.Profile": ILT's settings and tinkering salvage (Hub/IltSalvage.cs) for other
         plugins (ProfileInterface.cs), with the server plugins' own record and JSON writer. -->
    <Compile Include="..\Shared\RynthServerProfileApi.cs" Link="Shared\RynthServerProfileApi.cs" />
    <Compile Include="..\Shared\ServerPack\ServerPackInfo.cs" Link="ServerPack\ServerPackInfo.cs" />
    <Compile Include="..\Shared\ServerPack\ServerPackProfile.cs" Link="ServerPack\ServerPackProfile.cs" />
    <!-- ImGui.NET bound to the engine's cimgui (the tabs draw inside RynthAi's Mini Remote). -->
    <Compile Include="..\Shared\ImGuiNativeBinding.cs" Link="Shared\ImGuiNativeBinding.cs" />
    <!-- ImGui text calls are printf formats: dynamic text (names, chat, server lines) goes through SafeImGui. -->
    <Compile Include="..\Shared\SafeImGui.cs" Link="Shared\SafeImGui.cs" />
    <!-- Install-folder resolver (the ILT Hub files left in the RynthAi folder). -->
    <Compile Include="..\Shared\RynthInstallPaths.cs" Link="Shared\RynthInstallPaths.cs" />
    <!-- One logged, guarded way to use an object (the Guardian's vendor). -->
    <Compile Include="..\Shared\UseAudit.cs" Link="Shared\UseAudit.cs" />
    <!-- Save failures (its own files and the copies migrated from RynthAi) said in chat with the
         reason and the fix, as RynthAi's are. -->
    <Compile Include="..\Shared\DataWriteGuard.cs" Link="Shared\DataWriteGuard.cs" />
    <!-- AcObjectClass (the item classes the gear tools check). -->
    <Compile Include="..\..\Shared\RynthCore.LootSdk\AcGameEnums.cs" Link="Shared\AcGameEnums.cs" />
    <!-- ILT's /fship commands: sent to RynthAi's Fellowship view, and drawn in RynthCore's Fellowship section. -->
    <Compile Include="..\Shared\ServerCommandShare.cs" Link="Shared\ServerCommandShare.cs" />
    <Compile Include="..\Shared\ServerCommandPanel.cs" Link="Shared\ServerCommandPanel.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="ImGui.NET" />
  </ItemGroup>

  <ItemGroup>
    <!-- Offline tests (Tools\RynthILT.Tests) reach internal types. Test-only; no runtime effect. -->
    <InternalsVisibleTo Include="RynthILT.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\RynthCore\src\RynthCore.PluginCore\RynthCore.PluginCore.csproj" />
    <ProjectReference Include="..\..\..\RynthCore\src\RynthCore.PluginSdk\RynthCore.PluginSdk.csproj" />
  </ItemGroup>

  <!-- The engine supplies cimgui (RynthCore.cimgui.dll); ImGui.NET's own never ships beside the plugin. -->
  <Target Name="RemoveBundledImGuiNativeFromBuild" AfterTargets="Build">
    <Delete Files="$(OutputPath)cimgui.dll" Condition="Exists('$(OutputPath)cimgui.dll')" />
  </Target>

  <Target Name="RemoveBundledImGuiNativeFromPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <Delete Files="$(PublishDir)cimgui.dll" Condition="Exists('$(PublishDir)cimgui.dll')" />
  </Target>

</Project>
