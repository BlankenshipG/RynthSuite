<Project Sdk="Microsoft.NET.Sdk">

  <!-- RynthEversong: the Eversong server plugin. The build is shared (..\Shared\ServerPack\ServerPlugin.props);
       ServerData.cs holds what is known about the server. -->
  <PropertyGroup>
    <AssemblyName>RynthCore.Plugin.RynthEversong</AssemblyName>
    <!-- Previous release: 0.1.2. -->
    <Version>0.1.4</Version>
    <RynthPluginServerId>eversong</RynthPluginServerId>
    <RynthPluginServerName>Eversong</RynthPluginServerName>
    <RynthPluginServerHosts>eversong.abrdns.com</RynthPluginServerHosts>
    <RynthPluginServerWorldNames>Eversong</RynthPluginServerWorldNames>
    <RynthPluginDescription>Eversong only: the server card (rules, account limits, botting policy, links, account setup) in the Mini Remote.</RynthPluginDescription>
  </PropertyGroup>

  <Import Project="..\Shared\ServerPack\ServerPlugin.props" />

</Project>
