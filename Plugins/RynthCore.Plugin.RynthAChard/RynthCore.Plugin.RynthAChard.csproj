<Project Sdk="Microsoft.NET.Sdk">

  <!-- RynthAChard: the AChard server plugin (PvP). The build is shared (..\Shared\ServerPack\ServerPlugin.props);
       ServerData.cs holds what is known about the server. -->
  <PropertyGroup>
    <AssemblyName>RynthCore.Plugin.RynthAChard</AssemblyName>
    <!-- First release (no previous). -->
    <Version>0.1.0</Version>
    <RynthPluginServerId>achard</RynthPluginServerId>
    <RynthPluginServerName>AChard</RynthPluginServerName>
    <RynthPluginServerHosts>a-chard.ddns.net</RynthPluginServerHosts>
    <RynthPluginServerWorldNames>AChard|A-Chard</RynthPluginServerWorldNames>
    <RynthPluginDescription>AChard only: the server card (rules, account limits, botting policy, links, account setup) in the Mini Remote.</RynthPluginDescription>
  </PropertyGroup>

  <Import Project="..\Shared\ServerPack\ServerPlugin.props" />

</Project>
